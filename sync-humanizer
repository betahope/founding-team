#!/usr/bin/env bash
# cofounder-team sync-humanizer — pulls the humanizer pattern catalog from upstream.
#
# Why this exists: the `humanizer` skill's pattern catalog is not ours. It is
# blader's, maintained at https://github.com/blader/humanizer under the MIT
# licence. We used to keep a hand-written copy of it here, which slowly drifted
# out of date. Now we vendor the real thing instead.
#
# This script fetches the SKILL.md from blader's latest release and writes it,
# unmodified, to humanizer/references/upstream-patterns.md. That file is the
# source of truth for which AI writing patterns exist and how to fix each one.
# Our own humanizer/SKILL.md stays a thin layer on top: workflow, output sizing,
# the non-English rule, and the voice guidance.
#
# Nobody has to run this by hand. A weekly GitHub Action
# (.github/workflows/sync-humanizer.yml) runs it and opens a pull request when
# upstream has moved. Run it locally only if you want to sync early.
#
# Usage:
#   bash ./sync-humanizer            fetch and write the file if upstream moved
#   bash ./sync-humanizer --check    report only, write nothing
#
# Exit codes:
#   0  already up to date, or updated successfully
#   1  something went wrong (no network, bad response, unsafe content)
#   3  --check only: an update is available

set -euo pipefail

UPSTREAM_REPO="blader/humanizer"
UPSTREAM_URL="https://github.com/${UPSTREAM_REPO}"

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
OUT_FILE="$REPO_DIR/humanizer/references/upstream-patterns.md"

CHECK_ONLY=0
if [ "${1:-}" = "--check" ]; then
  CHECK_ONLY=1
elif [ -n "${1:-}" ]; then
  echo "sync-humanizer: unknown option '$1' (expected --check or nothing)" >&2
  exit 1
fi

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

# --- 1. Work out which upstream release to track -----------------------------
# Prefer the latest tagged release, so we never pick up half-finished work on
# the default branch. If the releases API is unreachable or rate limited, fall
# back to the default branch rather than failing the whole sync.
REF="main"
if curl -fsSL \
     -H 'Accept: application/vnd.github+json' \
     "https://api.github.com/repos/${UPSTREAM_REPO}/releases/latest" \
     > "$TMP_DIR/release.json" 2>/dev/null; then
  TAG="$(sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$TMP_DIR/release.json" | head -1)"
  if [ -n "$TAG" ]; then
    REF="$TAG"
  fi
fi
echo "Tracking upstream ref: $REF"

# --- 2. Fetch the upstream skill ---------------------------------------------
RAW_URL="https://raw.githubusercontent.com/${UPSTREAM_REPO}/${REF}/SKILL.md"
if ! curl -fsSL "$RAW_URL" > "$TMP_DIR/upstream.md"; then
  echo "sync-humanizer: could not download $RAW_URL" >&2
  exit 1
fi

if [ ! -s "$TMP_DIR/upstream.md" ]; then
  echo "sync-humanizer: downloaded file is empty" >&2
  exit 1
fi

# Sanity check: the thing we downloaded should look like the humanizer skill.
if ! head -20 "$TMP_DIR/upstream.md" | grep -q '^name:[[:space:]]*humanizer'; then
  echo "sync-humanizer: downloaded file does not look like the humanizer skill" >&2
  exit 1
fi

# Our build treats every .md file as a template. Upstream text must never
# contain a build directive, or the next build would try to expand it.
if grep -q '{{' "$TMP_DIR/upstream.md"; then
  echo "sync-humanizer: upstream file contains '{{', which our build would treat" >&2
  echo "as a template directive. Refusing to vendor it. Check upstream by hand." >&2
  exit 1
fi

# --- 3. Read the upstream version --------------------------------------------
UPSTREAM_VERSION="$(sed -n 's/^[[:space:]]*version:[[:space:]]*"\{0,1\}\([0-9][0-9.]*\)"\{0,1\}[[:space:]]*$/\1/p' "$TMP_DIR/upstream.md" | head -1)"
if [ -z "$UPSTREAM_VERSION" ]; then
  echo "sync-humanizer: could not read metadata.version from the upstream skill" >&2
  exit 1
fi

CURRENT_VERSION="none"
if [ -f "$OUT_FILE" ]; then
  CURRENT_VERSION="$(sed -n 's/^Upstream version: \(.*\)$/\1/p' "$OUT_FILE" | head -1)"
  [ -n "$CURRENT_VERSION" ] || CURRENT_VERSION="unknown"
fi

# --- 4. Build the vendored file ----------------------------------------------
# Strip the upstream YAML frontmatter (this is a reference note, not a skill of
# its own) and put our provenance header on top. Everything after the header is
# upstream's text, unchanged.
{
  cat <<HEADER
# AI writing patterns: the full catalog

Vendored, unmodified, from [${UPSTREAM_REPO}](${UPSTREAM_URL}). Created and
maintained by blader, MIT licensed, included here under those terms.

Upstream version: ${UPSTREAM_VERSION}
Upstream ref: ${REF}

**Do not edit this file by hand.** It is regenerated by \`bash ./sync-humanizer\`
at the repo root, and a weekly GitHub Action opens a pull request whenever
upstream publishes a new version. Hand edits are lost on the next sync.

**Which file wins.** This file is the authority on *which* AI writing patterns
exist and how to fix each one. Where it disagrees with the cofounder-team
\`SKILL.md\` on workflow, output length, language scope, or voice, \`SKILL.md\`
wins.

---

HEADER
  awk 'NR==1 && $0=="---" { infm=1; next } infm && $0=="---" { infm=0; next } !infm { print }' "$TMP_DIR/upstream.md"
} > "$TMP_DIR/vendored.md"

# --- 5. Compare and report ----------------------------------------------------
if [ -f "$OUT_FILE" ] && cmp -s "$TMP_DIR/vendored.md" "$OUT_FILE"; then
  echo "Already up to date (upstream humanizer $CURRENT_VERSION)."
  if [ -n "${GITHUB_OUTPUT:-}" ]; then
    echo "updated=false" >> "$GITHUB_OUTPUT"
    echo "version=$CURRENT_VERSION" >> "$GITHUB_OUTPUT"
  fi
  exit 0
fi

if [ "$CHECK_ONLY" -eq 1 ]; then
  echo "Update available: upstream humanizer $CURRENT_VERSION -> $UPSTREAM_VERSION"
  echo "Run 'bash ./sync-humanizer' to pull it in."
  if [ -n "${GITHUB_OUTPUT:-}" ]; then
    echo "updated=true" >> "$GITHUB_OUTPUT"
    echo "version=$UPSTREAM_VERSION" >> "$GITHUB_OUTPUT"
  fi
  exit 3
fi

mkdir -p "$(dirname "$OUT_FILE")"
cp "$TMP_DIR/vendored.md" "$OUT_FILE"
echo "Updated humanizer/references/upstream-patterns.md: $CURRENT_VERSION -> $UPSTREAM_VERSION"
echo "Review the diff, then run 'bash ./build' before committing."
if [ -n "${GITHUB_OUTPUT:-}" ]; then
  echo "updated=true" >> "$GITHUB_OUTPUT"
  echo "version=$UPSTREAM_VERSION" >> "$GITHUB_OUTPUT"
fi
